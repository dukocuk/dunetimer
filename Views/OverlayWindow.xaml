<Window x:Class="DuneTimer.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DuneTimer"
        Width="320" Height="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#1A1A2E" />
        <SolidColorBrush x:Key="CardBg" Color="#16213E" />
        <SolidColorBrush x:Key="AccentBrush" Color="#E94560" />
        <SolidColorBrush x:Key="TextPrimary" Color="#EAEAEA" />
        <SolidColorBrush x:Key="TextMuted" Color="#666666" />
        <SolidColorBrush x:Key="ProgressTrack" Color="#0F3460" />

        <Style x:Key="RowIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource PanelBg}"
            CornerRadius="12" Opacity="0.90">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- Header bar (draggable once interactive — Alt+X) -->
            <Border Grid.Row="0" Background="{Binding HeaderBrush}"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="⏱ DUNE TIMER"
                               Foreground="White"
                               FontFamily="Segoe UI"
                               FontSize="15" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0" />
                    <TextBlock Text="{Binding HeaderHintText}"
                               Foreground="#88FFFFFF"
                               FontSize="10"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="0,0,14,0" />
                </Grid>
            </Border>

            <!-- Timer list -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Margin="8,4,8,4">
                <ItemsControl ItemsSource="{Binding ActiveTimers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBg}"
                                    CornerRadius="8" Padding="10,8" Margin="0,3">
                                <StackPanel>
                                    <!-- Icon + Name, mute/delete buttons -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontSize="12" FontFamily="Segoe UI"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   VerticalAlignment="Center">
                                            <Run Text="{Binding Icon, Mode=OneWay}" />
                                            <Run Text=" " />
                                            <Run Text="{Binding Name, Mode=OneWay}" />
                                        </TextBlock>
                                        <Button Grid.Column="1" Content="{Binding MuteGlyph, Mode=OneWay}"
                                                Command="{Binding ToggleMuteCommand}"
                                                IsEnabled="{Binding CanToggleMute, Mode=OneWay}"
                                                Style="{StaticResource RowIconButton}"
                                                ToolTip="Mute/unmute this timer" />
                                        <Button Grid.Column="2" Content="✕"
                                                Command="{Binding DeleteCommand}"
                                                Style="{StaticResource RowIconButton}"
                                                ToolTip="Remove this timer" />
                                    </Grid>

                                    <!-- Countdown -->
                                    <TextBlock Text="{Binding FormattedRemaining, Mode=OneWay}"
                                               FontFamily="Consolas"
                                               FontSize="22" FontWeight="Bold"
                                               Foreground="{Binding TimerColor, Mode=OneWay}"
                                               Margin="0,2,0,4" />

                                    <!-- Progress bar -->
                                    <Grid Height="6">
                                        <Border Background="{StaticResource ProgressTrack}"
                                                CornerRadius="3" />
                                        <Border Background="{StaticResource AccentBrush}"
                                                CornerRadius="3"
                                                HorizontalAlignment="Left"
                                                Width="{Binding ProgressWidth, Mode=OneWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state -->
            <TextBlock Grid.Row="1"
                       Text="No active timers&#x0a;&#x0a;Alt+N  Manual timer&#x0a;Ctrl+Alt+R Set OCR Region&#x0a;Alt+S  Start OCR scanner&#x0a;Alt+D  Run Auto-Detect&#x0a;Alt+X  Click buttons on/off"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="13" FontFamily="Segoe UI"
                       TextAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding EmptyStateVisibility}" />

            <!-- Scanner status bar -->
            <Border Grid.Row="2" CornerRadius="0,0,12,12"
                    Background="#0D0D1A" Padding="10,4">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Ellipse Width="8" Height="8"
                                 Fill="{Binding ScannerStatusColor}"
                                 Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ScannerStatusText}"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="10" FontFamily="Segoe UI"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="{Binding MuteGlyph}" ToolTip="Mute/unmute all alerts"
                                Command="{Binding MuteCommand}"
                                Background="#333333" Foreground="White"
                                FontSize="10" Padding="8,2" Margin="0,0,6,0"
                                BorderThickness="0"
                                Cursor="Hand" />
                        <Button Content="Auto-Detect"
                                Command="{Binding AutoDetectCommand}"
                                Background="#E94560" Foreground="White"
                                FontSize="10" Padding="8,2"
                                BorderThickness="0"
                                Cursor="Hand" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
