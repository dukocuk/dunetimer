<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\DuneTimer.ico</ApplicationIcon>
    <AssemblyName>DuneTimer</AssemblyName>
    <RootNamespace>DuneTimer</RootNamespace>
    <Version>1.2.2</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms auto-adds a global "using System.Windows.Forms;" that
         collides with WPF's own global "using System.Windows;" across the
         whole project (Application, Brush, Point, Rectangle, etc.). Only
         Services\TrayIconService.cs needs System.Windows.Forms, and it
         brings its own file-scoped using for that. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <None Update="recipes.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="stations.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="Assets\alert.wav" Condition="Exists('Assets\alert.wav')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Update="tessdata\eng.traineddata">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- UseWindowsForms now supplies System.Drawing.Common from the in-box
         Windows Desktop shared framework; the explicit package reference
         pulled in a mismatched (net10-targeted) build that crashed WinForms
         controls at runtime with a System.Private.Windows.Core TypeLoadException. -->
    <PackageReference Include="Tesseract" Version="5.2.0" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- Tesseract ships its native libs via a legacy build\Tesseract.targets copy
       (x64\*.dll next to the exe) rather than the runtimes/<rid>/native convention,
       so single-file publish never picks them up as bundle-worthy natives and they
       silently vanish from the publish output, breaking OCR with no visible error. -->
  <Target Name="CopyNativeTesseractLibsToPublishDir" AfterTargets="Publish">
    <Error Condition="'$(PkgTesseract)' == ''" Text="Tesseract package path not resolved; check GeneratePathProperty on the Tesseract PackageReference." />
    <ItemGroup>
      <TesseractNativeLibs Include="$(PkgTesseract)\x64\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(TesseractNativeLibs)" DestinationFolder="$(PublishDir)x64\" />
    <Error Condition="!Exists('$(PublishDir)x64\tesseract50.dll')" Text="tesseract50.dll missing from publish output after copy." />
    <Error Condition="!Exists('$(PublishDir)tessdata\eng.traineddata')" Text="tessdata\eng.traineddata missing from publish output." />
  </Target>
</Project>
