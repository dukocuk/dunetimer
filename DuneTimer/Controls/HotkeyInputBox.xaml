<UserControl x:Class="DuneTimer.Controls.HotkeyInputBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Border x:Name="Root" Background="#16213E" BorderBrush="#0F3460" BorderThickness="1"
            Padding="10,5" Cursor="Hand" MinWidth="150" CornerRadius="3">
        <TextBlock x:Name="DisplayText" Text="Unbound" Foreground="#EAEAEA" FontSize="13"
                   FontFamily="Segoe UI" HorizontalAlignment="Center" />
    </Border>
</UserControl>
