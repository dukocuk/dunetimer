<Window x:Class="DuneTimer.Views.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dune Timer — Add Timer"
        Width="420" Height="600"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="#1A1A2E"
        ResizeMode="NoResize">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBg" Color="#16213E" />
        <SolidColorBrush x:Key="AccentBrush" Color="#E94560" />
        <SolidColorBrush x:Key="TextPrimary" Color="#EAEAEA" />
        <SolidColorBrush x:Key="TextMuted" Color="#666666" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <!-- Segmented-control look for the zone radio buttons -->
        <Style x:Key="ZoneOption" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="{StaticResource CardBg}"
                                BorderBrush="#0F3460" BorderThickness="2"
                                CornerRadius="4" Padding="14,6" Margin="0,0,8,0">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <!-- Zone-colored outline rather than fill: white text stays readable on both -->
                                <Setter TargetName="Bg" Property="Background" Value="#0F3460" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <!-- Zone: defaults to the overlay's current zone -->
        <TextBlock Text="Zone" Foreground="{StaticResource TextPrimary}"
                   FontSize="13" Margin="0,0,0,6" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <RadioButton Content="Hagga Basin" GroupName="Zone" Tag="#C8923A"
                         IsChecked="{Binding IsHaggaBasin}"
                         Style="{StaticResource ZoneOption}" />
            <RadioButton Content="Deep Desert" GroupName="Zone" Tag="#4E6CF0"
                         IsChecked="{Binding IsDeepDesert}"
                         Style="{StaticResource ZoneOption}" />
        </StackPanel>

        <!-- Category selector -->
        <TextBlock Text="Category" Foreground="{StaticResource TextPrimary}"
                   FontSize="13" Margin="0,0,0,6" />
        <ComboBox ItemsSource="{Binding Categories}"
                  SelectedItem="{Binding SelectedCategory}"
                  DisplayMemberPath="Name"
                  FontSize="13" />

        <!-- Recipe list -->
        <TextBlock Text="Recipe" Foreground="{StaticResource TextPrimary}"
                   FontSize="13" Margin="0,16,0,6" />
        <ListBox ItemsSource="{Binding Recipes}"
                 SelectedItem="{Binding SelectedRecipe}"
                 DisplayMemberPath="DisplayText"
                 Background="{StaticResource CardBg}"
                 Foreground="{StaticResource TextPrimary}"
                 Height="160" FontSize="13"
                 BorderBrush="#0F3460" BorderThickness="1" />

        <!-- Quantity -->
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <TextBlock Text="Quantity:" Foreground="{StaticResource TextPrimary}"
                       FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                     Width="60" FontSize="13"
                     Background="{StaticResource CardBg}"
                     Foreground="{StaticResource TextPrimary}"
                     BorderBrush="#0F3460" Padding="4,2" />
        </StackPanel>

        <!-- Divider -->
        <TextBlock Text="— OR Custom Timer —" Foreground="{StaticResource TextMuted}"
                   FontSize="12" TextAlignment="Center" Margin="0,20,0,10" />

        <!-- Custom timer -->
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Name:" Foreground="{StaticResource TextPrimary}"
                       FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}"
                     Width="120" FontSize="13"
                     Background="{StaticResource CardBg}"
                     Foreground="{StaticResource TextPrimary}"
                     BorderBrush="#0F3460" Padding="4,2" Margin="0,0,12,0" />
            <TextBlock Text="Min:" Foreground="{StaticResource TextPrimary}"
                       FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Text="{Binding CustomMinutes, UpdateSourceTrigger=PropertyChanged}"
                     Width="50" FontSize="13"
                     Background="{StaticResource CardBg}"
                     Foreground="{StaticResource TextPrimary}"
                     BorderBrush="#0F3460" Padding="4,2" Margin="0,0,10,0" />
            <TextBlock Text="Sec:" Foreground="{StaticResource TextPrimary}"
                       FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Text="{Binding CustomSeconds, UpdateSourceTrigger=PropertyChanged}"
                     Width="50" FontSize="13"
                     Background="{StaticResource CardBg}"
                     Foreground="{StaticResource TextPrimary}"
                     BorderBrush="#0F3460" Padding="4,2" />
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" Margin="0,24,0,0"
                    HorizontalAlignment="Center">
            <Button Content="▶ Start Timer"
                    Command="{Binding StartTimerCommand}"
                    Background="{StaticResource AccentBrush}"
                    Foreground="White" FontSize="14" FontFamily="Segoe UI"
                    Padding="24,10" Margin="0,0,12,0"
                    BorderThickness="0" Cursor="Hand" />
            <Button Content="Cancel"
                    Click="Cancel_Click"
                    Background="#333333" Foreground="White"
                    FontSize="14" FontFamily="Segoe UI"
                    Padding="24,10"
                    BorderThickness="0" Cursor="Hand" />
        </StackPanel>
    </StackPanel>
</Window>
